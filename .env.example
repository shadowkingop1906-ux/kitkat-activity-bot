# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=optional_guild_id_for_instant_command_registration

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/discord_activity_db?retryWrites=true&w=majority

# Render Web Service Port (Render sets this automatically)
PORT=3000

# Bot Behavior Customization
TRACK_DEAFENED_USERS=false
IGNORE_AFK_CHANNEL=true
